# 心与星寻 · Streamlit Secrets 示例（管理者网站）
#
# 用法：
#   本地 → 复制成 .streamlit/secrets.toml（已被 .gitignore 排除，不会上传）
#   云端 → 在 Streamlit Cloud 的 App 设置里选 Secrets，把下面内容粘进去
#
# ⚠️ 下面三个值必须是【真实值】才能登录后台，且 db_key 与云端 app_config.admin_key_hash 对应。
#    真实值请向项目所有者索取，不要写进本文件、不要提交进 Git。

[admin]
email    = "your-name@example.com"
password = "<登录密码>"
db_key   = "<64 位十六进制密钥>"
